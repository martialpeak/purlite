<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/dl" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/modern_bg" tools:context=".MainActivity">
    <androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/main_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="24dp">
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <ImageView android:id="@+id/flgimg" android:layout_width="80dp" android:layout_height="40dp" android:layout_marginBottom="24dp" android:background="@drawable/modern_card" android:padding="4dp" android:scaleType="fitCenter" android:elevation="4dp" />
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="32dp">
                <View android:id="@+id/glow_ring" android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="center" android:background="@drawable/modern_glow" android:alpha="0.6" />
                <Button android:id="@+id/btnToggle" android:layout_width="140dp" android:layout_height="140dp" android:layout_gravity="center" android:background="@drawable/circle_button" android:gravity="center" android:text="OFF" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" android:elevation="8dp" android:stateListAnimator="@null" />
            </FrameLayout>
            <TextView android:id="@+id/core_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/notconnect" android:textColor="@color/text_secondary" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/modern_card" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:layout_marginBottom="16dp" android:elevation="2dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/modern_glow" android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/connected_server_delay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="@string/testserver" android:textColor="@color/accent_cyan" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" />
            </LinearLayout>
            <TextView android:id="@+id/versionnn" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_muted" android:textSize="11sp" android:fontFamily="monospace" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.google.android.material.navigation.NavigationView android:id="@+id/na" android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="right" android:background="@drawable/modern_nav_bg" android:layout_marginStart="48dp" app:headerLayout="@layout/heder" app:itemTextColor="@color/yello" app:menu="@menu/options_menu" app:elevation="16dp" />
</androidx.drawerlayout.widget.DrawerLayout>