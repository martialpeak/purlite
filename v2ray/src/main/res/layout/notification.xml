        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="2dp">
            <TextView android:id="@+id/txtsp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سرعت" android:textColor="@color/gr" android:textSize="9sp" />
            <TextView android:id="@+id/speeeeddd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="TextView" android:textColor="@color/gr" android:textSize="9sp" />
        </LinearLayout>
